# LOCAL DEV ONLY (`pnpm dev` on the host, using the docker services).
#
# Docker deployments do NOT read this file: the api container is configured
# from the root `.env` via `docker-compose.yaml`. That is why the hosts below
# are `localhost` and not `postgres`/`redis`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app-db
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000

# settings (optional)
PORT=4000
CACHE_TTL=10000
