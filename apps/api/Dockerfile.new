# ---------------------------------------------------------------------------
# Single-stage runtime image.
#
# No pnpm/turbo here on purpose: the build context passed to `docker build`
# is already a PRE-BUILT artifact tree (see scripts/build-and-push.sh),
# produced once on the host/CI via:
#   pnpm turbo prune api --out-dir out
#   pnpm --dir out install --frozen-lockfile
#   pnpm --dir out turbo build
#
# This Dockerfile only copies that tree in and runs it -- nothing here
# installs dependencies or compiles anything.
# ---------------------------------------------------------------------------
ARG NODE_VERSION=26.0.0
FROM node:${NODE_VERSION}-slim

# Prisma needs openssl, which is not in the slim image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Don't run production as root
RUN addgroup --system --gid 1001 nestjs \
  && adduser --system --uid 1001 --ingroup nestjs nestjs

WORKDIR /app
COPY --chown=nestjs:nestjs . .

USER nestjs

# Documentation only: the published port is set in docker-compose.yaml.
EXPOSE 4000

CMD ["node","apps/api/dist/main.js"]
