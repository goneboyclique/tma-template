{
  "name": "turborepo",
  "version": "1.0.0",
  "author": "clay.zenx@gmail.com",
  "type": "module",
  "description": "turborepo templates for your next future projects",
  "packageManager": "pnpm@11.18.0",
  "lint-staged": {
    "*.{js,ts,vue,css,md,json}": "prettier --write"
  },
  "scripts": {
    "build": "turbo build && pnpm format",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:deploy": "turbo db:deploy",
    "sdk:generate": "turbo run sdk:generate && pnpm format"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  }
}
