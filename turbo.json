{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",

  "globalEnv": ["DATABASE_URL", "VITE_API_URL"],

  "tasks": {
    "build": {
      "dependsOn": ["^db:generate"],
      "outputs": ["dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_API_URL", "VITE_HTTPS"]
    },

    "start:tg-dev": {
      "cache": false,
      "persistent": true
    },

    "test": {
      "dependsOn": ["^build"]
    },

    "start:prod": { "cache": false },

    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },

    "db:generate": {
      "env": ["DATABASE_URL"],
      "cache": false
    },

    "db:migrate": {
      "env": ["DATABASE_URL"],
      "cache": false
    },

    "db:reset": {
      "env": ["DATABASE_URL"],
      "cache": false
    },

    "db:deploy": {
      "env": ["DATABASE_URL"],
      "cache": false
    },

    "sdk:generate": {
      "cache": false
    }
  }
}
