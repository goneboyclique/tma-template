# =============================================================================
# Root .env — single source of truth for `docker compose`.
#
#   cp .env.example .env
#
# Compose auto-loads THIS file only (never the per-package ones) and injects
# the values into the containers explicitly, see `docker-compose.yaml`.
# Variables marked "required" abort `docker compose up` when missing.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Infrastructure — consumed by docker compose only
#
# The container DATABASE_URL is ASSEMBLED from these parts by compose, using the
# in-network hostname `postgres`. Do not write a container DATABASE_URL here.
#
# NOTE: postgres reads these on FIRST initialization only. Changing them later
# requires recreating the volume: `docker compose down -v` (destroys all data).
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # required — change this on the VPS
POSTGRES_DB=app-db

# Host-side published ports (bound to 127.0.0.1, not public).
POSTGRES_PORT=5433
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 2. API runtime — injected into the api container by compose
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000 # required — your frontend origin

# settings (optional, defaults shown)
NODE_ENV=production
PORT=4000     # port INSIDE the container
API_PORT=4000 # port published on the host
CACHE_TTL=60000

# Override the built image tag (e.g. when pulling from a registry).
# API_IMAGE=archiveplay-api:latest

# -----------------------------------------------------------------------------
# 3. Host tooling only — IGNORED by every container
#
# Used when running prisma/orval from the repo root on the host, which is why
# the host here is `localhost` and not `postgres`. Keep credentials in sync
# with section 1.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app-db
# OpenApi input src (required) for generating the client
OPENAPI_INPUT_SRC="http://localhost:4000/api-json"
