# =============================================================================
# ton-payment configuration.
#
#   cp .env.example .env
#
# This single file configures `docker compose` AND the API when you run it on
# the host. Values marked "required" abort `docker compose up` by name when
# missing, before any container starts.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Merchant configuration — what makes this deployment yours
# -----------------------------------------------------------------------------

# TON address that receives payments.
PAYMENT_WALLET=

# Telegram bot whose Mini App init data authenticates API callers.
TELEGRAM_BOT_TOKEN=

# TON Center API key: https://toncenter.com (use the testnet bot for testnet).
TONCENTER_API_KEY=

# Jetton master for USDT on the network you target. The value below is the
# TESTNET master — replace it for mainnet.
USDT_JETTON_MASTER=kQCDV9KOSMCkniZAuGsddFbdKExF6aOfw5tNEnY9op81CwQa

# Network endpoints. Defaults (used when left empty) are TESTNET; switch both
# together, along with USDT_JETTON_MASTER above, to go to mainnet:
#   TONCENTER_API_URL=https://toncenter.com/api/v2/jsonRPC
#   TONCENTER_WS_URL=wss://toncenter.com/api/streaming/v2/ws
TONCENTER_API_URL=
TONCENTER_WS_URL=

# -----------------------------------------------------------------------------
# 2. Database (compose only)
#
# The container DSN is assembled from these parts using the in-network host
# `postgres`. Do not write a container DATABASE_URL here.
#
# NOTE: postgres reads these on FIRST initialization only. Changing them later
# requires recreating the volume: `docker compose down -v` (destroys all data).
# -----------------------------------------------------------------------------
POSTGRES_USER=ton_payment
POSTGRES_PASSWORD= # required — use a strong value in production
POSTGRES_DB=ton_payment

# Host port, only if you uncomment the postgres `ports` block in compose.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 3. API runtime (optional, defaults shown)
# -----------------------------------------------------------------------------

# Comma-separated allowed origins for HTTP and socket.io. Lock this down in
# production.
CORS_ORIGINS=*

# Where the API is published on the host. The default only listens on
# loopback; set API_BIND=0.0.0.0 to expose it directly (prefer a reverse
# proxy). The port inside the container is always 4000.
API_BIND=127.0.0.1
API_PORT=4000

# Override the image tag, e.g. when pulling a published build instead of
# building locally.
# API_IMAGE=ton-payment-api:latest

# Set to false to apply migrations yourself instead of on container start.
# RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# 4. Host tooling only — IGNORED by every container
#
# Used when running prisma or orval from the repo root on the host, which is
# why the host here is `localhost` and not `postgres`. Keep the credentials in
# sync with section 2, and publish the postgres port for it to work.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ton_payment:changeme@localhost:5432/ton_payment

# OpenAPI document the SDK generator reads (`pnpm sdk:generate`). 
# You can start api package first `pnpm --filter api dev` then generate the SDK (pnpm sdk:generate).
OPENAPI_INPUT_SRC="http://localhost:4000/api-json"

# -----------------------------------------------------------------------------
# 3. Vite runtime (optional, defaults shown)
# 
# You would like to use if you want to develop and test locally with Vite frontend tma app.
# -----------------------------------------------------------------------------

VITE_HTTPS=true # Creates a custom SSL certificate valid for the local machine.
# App API url for reverse proxy
VITE_API_URL=http://localhost:4000

